# Public site origin (canonical host: khesht123.ir — contact/QR page is /card)
VITE_SITE_URL=http://localhost:5173

# WordPress REST origin. Leave empty in local Vite to use the mock API.
# Example production: https://cms.khesht123.com
VITE_API_BASE=http://khesht.local

# Locale for UI chrome. Content locale is requested as ?lang=
VITE_LOCALE=fa

# --- Live prices (local dev only; production uses the WordPress plugin) ---
# Get a key from https://www.navasan.tech (web service). NOT prefixed with VITE_ on purpose.
NAVASAN_API_KEY=
# Optional: override item keys if your Navasan panel names them differently
# NAVASAN_ITEMS={"gold":{"key":"18ayar","label":"طلای ۱۸ عیار"},"coin":{"key":"sekkeh","label":"سکه امامی"}}

# --- Live prices source ---
# widget (default): Navasan's free script, no API key.   api: WordPress /market-quotes (needs a Navasan API key on the server)
VITE_PRICES_SOURCE=widget
